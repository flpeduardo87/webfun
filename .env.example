# Google Analytics 4 (opcional, recomendado)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console (opcional; valor da meta tag de verificação)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Lead capture — TODOS OPCIONAIS.
# O canal principal de leads é o handoff do formulário para o WhatsApp da Webfun.
# As opções abaixo são apenas registro extra (best-effort); uma falha nelas nunca
# quebra o formulário.
#
# CONTACT_WEBHOOK_URL: envia o lead (JSON) para Make/Zapier/n8n/Supabase etc.
CONTACT_WEBHOOK_URL=
#
# LEADS_FILE_PATH: grava um .jsonl. Só funciona se o filesystem for persistente e
# acessível — em hospedagem Node containerizada (ex.: Hostinger) o arquivo pode
# ficar isolado do gerenciador de arquivos e sumir no redeploy. Prefira o webhook.
LEADS_FILE_PATH=
